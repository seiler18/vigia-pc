<UserControl x:Class="Vigia.Interfaz.Segmento"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Center">
    <!-- Un componente: qué es, qué tan caliente, hacia dónde va, qué tan
         cargado y el detalle. La posición de cada pieza la decide Orientar():
         en fila en los bordes de arriba y abajo, en bloque en los costados. -->
    <Grid x:Name="Raiz">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Titulo" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextoSecundario}" />
        <TextBlock x:Name="Valor" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextoPrincipal}" Typography.NumeralAlignment="Tabular" />

        <!-- Tendencia de los últimos 2 minutos; la punteada es el umbral de
             atención: si la curva se le acerca, hay que mirar. -->
        <Canvas x:Name="Grafico" Width="56" Height="16" ClipToBounds="True"
                VerticalAlignment="Center" Visibility="Collapsed">
            <Line x:Name="LineaUmbral" Stroke="{DynamicResource TextoTenue}" StrokeThickness="1"
                  StrokeDashArray="2,3" X1="0" />
            <Polyline x:Name="Curva" StrokeThickness="1.5" StrokeLineJoin="Round" />
        </Canvas>

        <TextBlock x:Name="Porcentaje" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextoPrincipal}" Typography.NumeralAlignment="Tabular" />
        <TextBlock x:Name="Detalle" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextoSecundario}" Typography.NumeralAlignment="Tabular" />
    </Grid>
</UserControl>
