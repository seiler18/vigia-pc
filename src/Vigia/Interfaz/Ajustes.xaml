<!-- Tema oscuro fijo y fondo sólido: el fondo «Mica» del tema Fluent necesita
     render por GPU y Vigía dibuja por software (para no quitarle GPU al
     juego); sin un fondo propio la ventana quedaba semitransparente. -->
<Window x:Class="Vigia.Interfaz.Ajustes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personalizar Vigía"
        ThemeMode="Dark" Background="#202020"
        Icon="/Recursos/vigia.ico"
        Width="460" Height="720" MinWidth="400" MinHeight="420"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style x:Key="Seccion" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,22,0,10" />
        </Style>
        <Style x:Key="Nota" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="28,0,0,8" />
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Cifra" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,12">
            <DockPanel>
                <Button Content="Restablecer apariencia" Click="AlRestablecer" />
                <Button Content="Cerrar" Click="AlCerrar" HorizontalAlignment="Right" MinWidth="96" IsDefault="True" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0,20,16">

                <!-- Solo aparece si a este usuario le falta el permiso: quien ya
                     lo tiene no necesita leer nada de esto. -->
                <StackPanel x:Name="SeccionFps" Visibility="Collapsed">
                    <TextBlock Text="FPS" Style="{StaticResource Seccion}" />
                    <TextBlock x:Name="TextoFps" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Para leer los FPS, Windows pide un permiso que se da una sola vez." />
                    <Button x:Name="BotonFps" Content="Activar FPS" Click="AlActivarFps"
                            HorizontalAlignment="Left" MinWidth="120" />
                </StackPanel>

                <TextBlock Text="Posición" Style="{StaticResource Seccion}" />
                <WrapPanel x:Name="Bordes">
                    <RadioButton Content="Arriba" Tag="Arriba" GroupName="borde" Margin="0,0,16,0" Checked="AlElegirBorde" />
                    <RadioButton Content="Abajo" Tag="Abajo" GroupName="borde" Margin="0,0,16,0" Checked="AlElegirBorde" />
                    <RadioButton Content="Izquierda" Tag="Izquierda" GroupName="borde" Margin="0,0,16,0" Checked="AlElegirBorde" />
                    <RadioButton Content="Derecha" Tag="Derecha" GroupName="borde" Checked="AlElegirBorde" />
                </WrapPanel>
                <CheckBox x:Name="Reservar" Content="Reservar el espacio" Margin="0,10,0,0" Click="AlCambiar" />
                <TextBlock Style="{StaticResource Nota}"
                           Text="Las ventanas maximizadas terminan donde empieza la franja: sus botones de minimizar y cerrar quedan a la vista." />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tamaño" Style="{StaticResource Etiqueta}" />
                    <Slider x:Name="Tamano" Grid.Column="1" Minimum="80" Maximum="160" TickFrequency="10"
                            IsSnapToTickEnabled="True" ValueChanged="AlDeslizar" />
                    <TextBlock x:Name="TamanoTexto" Grid.Column="2" Style="{StaticResource Cifra}" />
                </Grid>

                <TextBlock Text="Colores" Style="{StaticResource Seccion}" />
                <TextBlock Text="Fondo" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <WrapPanel x:Name="MuestrasFondo" />
                    <TextBox x:Name="HexFondo" Width="86" Margin="8,0,0,0" VerticalAlignment="Center"
                             LostFocus="AlEscribirHex" KeyDown="AlTeclaHex" ToolTip="Cualquier color en formato #RRGGBB" />
                </StackPanel>
                <TextBlock Text="Texto" Margin="0,12,0,6" />
                <StackPanel Orientation="Horizontal">
                    <WrapPanel x:Name="MuestrasTexto" />
                    <TextBox x:Name="HexTexto" Width="86" Margin="8,0,0,0" VerticalAlignment="Center"
                             LostFocus="AlEscribirHex" KeyDown="AlTeclaHex" ToolTip="Cualquier color en formato #RRGGBB" />
                </StackPanel>
                <TextBlock Text="Avisos" Margin="0,12,0,6" />
                <RadioButton x:Name="Semaforo" Content="Verde · ámbar · rojo" GroupName="estados" Checked="AlCambiar" />
                <RadioButton x:Name="Daltonismo" Content="Azul · naranja · rosa (para daltonismo)" GroupName="estados" Margin="0,6,0,0" Checked="AlCambiar" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Opacidad" Style="{StaticResource Etiqueta}" />
                    <Slider x:Name="Opacidad" Grid.Column="1" Minimum="30" Maximum="100" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="AlDeslizar" />
                    <TextBlock x:Name="OpacidadTexto" Grid.Column="2" Style="{StaticResource Cifra}" />
                </Grid>

                <TextBlock Text="Qué mostrar" Style="{StaticResource Seccion}" />
                <WrapPanel>
                    <CheckBox x:Name="VerFps" Content="FPS" Margin="0,0,20,0" Click="AlCambiar" />
                    <CheckBox x:Name="VerGpu" Content="GPU" Margin="0,0,20,0" Click="AlCambiar" />
                    <CheckBox x:Name="VerCpu" Content="CPU" Margin="0,0,20,0" Click="AlCambiar" />
                    <CheckBox x:Name="VerRam" Content="RAM" Click="AlCambiar" />
                </WrapPanel>
                <CheckBox x:Name="VerTendencias" Content="Tendencia de los últimos 2 minutos" Margin="0,10,0,0" Click="AlCambiar" />
                <CheckBox x:Name="Minimo" Content="Modo mínimo: solo los valores" Margin="0,6,0,0" Click="AlCambiar" />

                <TextBlock Text="Umbrales" Style="{StaticResource Seccion}" />
                <TextBlock Style="{StaticResource Nota}" Margin="0,-4,0,10"
                           Text="Desde «atención» el valor se pinta de ámbar; desde «crítico», de rojo." />
                <Grid x:Name="Umbrales">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Text="Atención" Opacity="0.7" FontSize="12" />
                    <TextBlock Grid.Column="3" Text="Crítico" Opacity="0.7" FontSize="12" Margin="12,0,0,0" />
                </Grid>
                <CheckBox x:Name="AvisoWindows" Content="Aviso de Windows al llegar a crítico" Margin="0,12,0,0" Click="AlCambiar" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
